{
  "skill": "blog-writing",
  "suite": "writing",
  "version": "2026-04-11",
  "hard_rule_checks": [
    "required_greeting",
    "required_farewell",
    "artifact_path_pattern"
  ],
  "hard_rules": {
    "required_greeting": {
      "text": "Ahnii!",
      "paragraph_position": "first"
    },
    "required_farewell": {
      "text": "Baamaapii",
      "paragraph_position": "last"
    },
    "artifact_path_pattern": {
      "prefix": "content/posts/",
      "suffix": "/index.md"
    }
  },
  "cases": [
